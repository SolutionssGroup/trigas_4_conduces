<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="picking_type_trigas_step_1" model="stock.picking.type">
        <field name="name">Trigas - Conduce 1</field>
        <field name="code">internal</field>
        <field name="sequence_code">TRI1</field>
        <field name="barcode_validation_full">True</field>
        <field name="show_operations">True</field>
        <field name="show_reserved">True</field>
        <field name="show_entire_packs">True</field>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="barcode_app_action"
               eval="{
                    'domain': [
                        ('is_trigas_conduce', '=', True),
                        ('trigas_step', '=', '1'),
                        ('state', 'not in', ['done', 'cancel'])
                    ],
                    'context': {
                        'search_default_waiting': 1
                    }
               }"/>
    </record>

    <record id="picking_type_trigas_step_2" model="stock.picking.type">
        <field name="name">Trigas - Conduce 2</field>
        <field name="code">outgoing</field>
        <field name="sequence_code">TRI2</field>
        <field name="barcode_validation_full">True</field>
        <field name="show_operations">True</field>
        <field name="show_reserved">True</field>
        <field name="show_entire_packs">True</field>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="barcode_app_action"
               eval="{
                    'domain': [
                        ('is_trigas_conduce', '=', True),
                        ('trigas_step', '=', '2'),
                        ('state', 'not in', ['done', 'cancel'])
                    ],
                    'context': {
                        'search_default_waiting': 1
                    }
               }"/>
    </record>

</odoo>
