<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_trigas_delivery_signature_record" model="ir.actions.report">
        <field name="name">Firma de entrega Trigas</field>
        <field name="model">trigas.delivery.signature.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">trigas_4_conduces.report_trigas_delivery_signature_record_document</field>
        <field name="report_file">trigas_4_conduces.report_trigas_delivery_signature_record_document</field>
        <field name="print_report_name">'Firma de Entrega - %s' % (object.picking_id.name or object.id)</field>
    </record>

    <template id="report_trigas_delivery_signature_record_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #222; padding: 24px;">
                    <h2 style="margin-bottom: 20px;">Constancia de entrega firmada</h2>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                        <tr>
                            <td style="padding: 6px; width: 24%;"><strong>Conduce:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.picking_id.name"/>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Orden de venta:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.sale_order_id.name or ''"/>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Cliente:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.partner_id.name or ''"/>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Ubicación cliente:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.customer_location_id.display_name or ''"/>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Barcode ubicación:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.customer_location_barcode or ''"/>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Firmado por:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.signed_by or ''"/>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Fecha de firma:</strong></td>
                            <td style="padding: 6px;" t-esc="doc.signed_on or ''"/>
                        </tr>
                    </table>

                    <div style="margin-top: 24px;">
                        <div style="font-weight: bold; margin-bottom: 10px;">Firma digital</div>
                        <img t-if="doc.signature_image"
                             t-att-src="image_data_uri(doc.signature_image)"
                             style="max-width: 420px; max-height: 180px; border: 1px solid #ccc;"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
