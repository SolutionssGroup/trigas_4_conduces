<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_trigas_cylinder" model="ir.ui.view">
        <field name="name">product.template.form.trigas.cylinder</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Conduces">
                    <field name="is_cylinder_conduce" string="Usar flujo Trigas de 4 conduces"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>