<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_trigas_customer_location" model="ir.ui.view">
        <field name="name">res.partner.form.trigas.customer.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group string="Trigas">
                    <field name="trigas_customer_location_id" readonly="1"/>
                    <field name="trigas_customer_location_barcode" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>