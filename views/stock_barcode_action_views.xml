<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- CONDUCE 1 -->
    <record id="action_trigas_barcode_step_1" model="ir.actions.act_window">
        <field name="name">Entrega camión</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="stock_barcode.stock_picking_kanban"/>

        <field name="domain">
            [
                ('is_trigas_conduce', '=', True),
                ('trigas_step', '=', '1'),
                ('state', 'not in', ['done', 'cancel'])
            ]
        </field>

        <field name="context">
            {
                'search_default_waiting': 1
            }
        </field>
    </record>

    <!-- CONDUCE 2 -->
    <record id="action_trigas_barcode_step_2" model="ir.actions.act_window">
        <field name="name">Camión a cliente</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="stock_barcode.stock_picking_kanban"/>

        <field name="domain">
            [
                ('is_trigas_conduce', '=', True),
                ('trigas_step', '=', '2'),
                ('state', 'not in', ['done', 'cancel'])
            ]
        </field>

        <field name="context">
            {
                'search_default_waiting': 1
            }
        </field>
    </record>

    <!-- CONDUCE 3 / RECOGIDA DE CILINDROS -->
    <!-- Esta acción debe entrar al flujo Barcode/Kanban.
         Si no hay pendientes, el backend crea un picking TRI3 y abre Barcode/PDA. -->
    <record id="action_trigas_barcode_step_3" model="ir.actions.act_window">
        <field name="name">Recogida de cilindros</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="stock_barcode.stock_picking_kanban"/>
        <field name="domain">
            [
                ('is_trigas_conduce', '=', True),
                ('trigas_step', '=', '3'),
                ('state', 'not in', ['done', 'cancel'])
            ]
        </field>
        <field name="context">
            {
                'default_picking_type_id': ref('trigas_4_conduces.picking_type_trigas_step_3'),
                'search_default_waiting': 1,
                'contact_display': 'partner_address'
            }
        </field>
        <field name="target">current</field>
    </record>

    <!-- Mostrar orden de venta como dato principal en la tarjeta Kanban/PDA del Barcode -->
    <record id="view_trigas_barcode_picking_kanban_sale_order" model="ir.ui.view">
        <field name="name">stock.picking.kanban.trigas.sale.order.barcode</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_barcode.picking_view_kanban_inherit_barcode"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">

            <!-- Cargar campos necesarios para la tarjeta kanban -->
            <xpath expr="//kanban" position="inside">
                <field name="sale_order_id"/>
                <field name="is_trigas_conduce"/>
                <field name="location_id"/>
            </xpath>

            <!-- Reemplazar el título móvil: orden grande arriba, conduce pequeño debajo -->
            <xpath expr="//button[@name='action_open_picking_client_action']/span" position="replace">
                <span>
                    <t t-if="record.is_trigas_conduce.raw_value and record.sale_order_id.raw_value">
                        <span style="font-size: 15px; font-weight: 700; display: block; line-height: 1.2;">
                            Orden: <t t-esc="record.sale_order_id.value"/>
                        </span>
                        <span class="text-muted" style="font-size: 11px; display: block; line-height: 1.2;">
                            Conduce: <t t-esc="record.name.value"/>
                        </span>
                    </t>
                    <t t-else="">
                        <t t-esc="record.name.value"/>
                    </t>
                </span>
            </xpath>

            <!-- Recogida de Cilindros (TRI3): pie de tarjeta amigable con el cliente/origen
                 bien visible, el estado destacado con color y un botón de acción grande,
                 fácil de tocar con el dedo en pantallas de PDA.
                 Estos traslados son "nativos" (is_trigas_conduce = False, sin trigas_step),
                 por lo que se identifican por su referencia /TRI3/..., igual que
                 hace el JS del módulo para detectar la pantalla de Recogida de Cilindros. -->
            <xpath expr="//div[hasclass('o_kanban_record_bottom')]" position="after">
                <div t-if="record.name.value and record.name.value.indexOf('/TRI3/') !== -1"
                     class="trigas-tri3-kanban-footer">
                    <div class="trigas-tri3-kanban-footer-info">
                        <span class="trigas-tri3-kanban-origin">
                            <t t-esc="record.location_id.value"/>
                        </span>
                        <span t-attf-class="trigas-tri3-kanban-state trigas-tri3-state-#{record.state.raw_value}">
                            <t t-esc="record.state.value"/>
                        </span>
                    </div>
                    <button class="trigas-tri3-kanban-cta btn" name="action_open_picking_client_action" type="object">
                        Procesar recogida
                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                    </button>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
