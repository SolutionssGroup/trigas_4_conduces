<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_trigas" model="ir.ui.view">
        <field name="name">stock.picking.form.trigas</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_open_trigas_signature_wizard"
                        string="Firmar entrega"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('is_trigas_conduce', '=', False), ('trigas_step', '!=', '2')]}"/>

                <button name="action_open_trigas_signature_record"
                        string="Ver registro firma"
                        type="object"
                        attrs="{'invisible': ['|', ('is_trigas_conduce', '=', False), ('trigas_step', '!=', '2')]}"/>

                <button name="action_send_trigas_delivery_email"
                        string="Enviar firma al cliente"
                        type="object"
                        attrs="{'invisible': ['|', ('is_trigas_conduce', '=', False), ('trigas_step', '!=', '2')]}"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Flujo Trigas">
                    <field name="is_trigas_conduce" readonly="1"/>
                    <field name="trigas_step" readonly="1"/>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="trigas_customer_location_id" readonly="1"/>
                    <field name="trigas_truck_location_id"
                           attrs="{
                               'readonly': [('trigas_step', '!=', '1')],
                               'required': [('trigas_step', '=', '1')]
                           }"/>
                    <field name="trigas_signature_record_id" readonly="1"/>
                </group>

                <group string="Firma de entrega"
                       attrs="{'invisible': ['|', ('is_trigas_conduce', '=', False), ('trigas_step', '!=', '2')]}">
                    <field name="trigas_delivery_signature_status" readonly="1"/>
                    <field name="trigas_delivery_signed_by" readonly="1"/>
                    <field name="trigas_delivery_signed_on" readonly="1"/>
                    <field name="trigas_delivery_signature" widget="image" class="oe_avatar" readonly="1"/>
                </group>
            </xpath>

            <!-- Mostrar orden de venta en las líneas principales del conduce -->
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
                <field name="trigas_sale_order_name"
                       string="Orden de venta"
                       readonly="1"
                       optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
