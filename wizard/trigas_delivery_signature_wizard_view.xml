<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trigas_delivery_signature_wizard_form" model="ir.ui.view">
        <field name="name">trigas.delivery.signature.wizard.form</field>
        <field name="model">trigas.delivery.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Firma de entrega">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="signed_by"/>
                    <field name="signature" widget="signature"/>
                </group>
                <footer>
                    <button name="action_save_signature"
                            string="Guardar firma"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>